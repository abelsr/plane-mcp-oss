# Copy to `.env` (loaded automatically) or export these in your shell / MCP
# client config. CLI flags override all of these.

# --- Credentials -------------------------------------------------------------
# Personal access token from Plane: Profile settings -> Personal access tokens.
# Sent as the `X-API-Key` header. Alias: PLANE_TOKEN.
PLANE_API_KEY=plane_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Alternative to the API key: an OAuth access token, sent as `Authorization: Bearer ...`.
# PLANE_OAUTH_TOKEN=

# --- Instance ----------------------------------------------------------------
# Workspace slug from your Plane URL: https://app.plane.so/<workspace-slug>/projects/
# Alias: PLANE_WORKSPACE.
PLANE_WORKSPACE_SLUG=my-team

# Plane instance URL. Alias: PLANE_URL.
# Leave as the default for Plane Cloud, or point it at your self-hosted instance.
# All of these are accepted:
#   https://api.plane.so                 (Plane Cloud)
#   https://plane.example.com            (self-hosted)
#   https://example.com/plane            (self-hosted behind a subpath)
#   https://plane.example.com/api/v1     (version suffix included)
PLANE_BASE_URL=https://api.plane.so

# Request timeout in seconds.
PLANE_TIMEOUT=30
